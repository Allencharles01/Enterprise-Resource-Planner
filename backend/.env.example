# Server port (the frontend example is configured to use this port)
PORT=4001

# Paste your MongoDB Atlas connection string here. Do not commit backend/.env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/erp?retryWrites=true&w=majority

# Use a long, unique random value (at least 16 characters).
JWT_SECRET=replace-with-a-long-random-secret

# The address where the Next.js app runs locally.
WEB_ORIGIN=http://localhost:3001

# Optional. Required only when sending real outbound email through Resend.
RESEND_API_KEY=
